{
    "name": "fcl-portal-server",
    "version": "1.4.0",
    "license": "MIT",
    "scripts": {
        "start": "node --dns-result-order=ipv4first ./lib/main.js",
        "serve": "npx nodemon -e ts --exec \"npm run build && npm run test && node --dns-result-order=ipv4first ./lib/main.js\"",
        "debug": "npx nodemon -e ts --exec \"npm run build && node --inspect-brk --dns-result-order=ipv4first ./lib/main.js\"",
        "cp:view": "npx copyfiles -u 1 ./src/**/views/**/* ./lib",
        "cp:json": "npx copyfiles -u 1 ./src/**/*.json ./lib",
        "cp:scripts": "npx copyfiles -u 1 ./src/**/*.sh ./lib",
        "cp:all": "npm run cp:view && npm run cp:scripts && npm run cp:json",
        "tsc": "tsc",
        "build": "npm run clean &&  npm run tsc && npm run cp:all",
        "test": "jest --config=jest.json",
        "test:integration": "jest --config=jest-integration.json",
        "test:watch": "npm test -- --watch",
        "test:coverage": "npm test -- --coverage",
        "clean": "npx rimraf lib/*",
        "lint": "tslint --project tsconfig.json --fix -c tslint.json -e \"src/**/__mocks__/*.ts\" -e \"src/**/__tests__/*.ts\" -e \"test/**/*.ts\" \"src/**/*.ts\"",
        "pretty": "prettier --write \"src/**/*.ts\""
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "commit-msg": "./hooks/commit-msg ./.git/COMMIT_EDITMSG"
        }
    },
    "lint-staged": {
        "src/**/*.ts": [
            "npm run pretty",
            "npm run lint"
        ]
    },
    "private": true,
    "dependencies": {
        "@SiLeBAT/fg43-ne-server": "1.4.1",
        "argon2": "0.44.0",
        "bluebird": "~3.7.2",
        "compression": "~1.8.2",
        "config": "~3.3.12",
        "cors": "~2.8.6",
        "express": "4.22.3",
        "express-jwt": "^8.5.1",
        "fs-readfile-promise": "~3.0.1",
        "handlebars": "~4.7.10",
        "helmet": "~5.1.1",
        "inversify": "~6.0.3",
        "inversify-express-utils": "~6.5.0",
        "jsonwebtoken": "~9.0.3",
        "lodash": "~4.18.1",
        "moment": "~2.31.0",
        "mongoose": "~6.13.12",
        "mongoose-unique-validator": "~3.0.0",
        "morgan": "~1.12.1",
        "nodemailer": "10.3.1",
        "pm2": "^7.1.2",
        "reflect-metadata": "0.2.2",
        "swagger-ui-express": "~4.3.0",
        "winston": "~3.8.2"
    },
    "devDependencies": {
        "@types/bluebird": "~3.5.42",
        "@types/compression": "~1.8.1",
        "@types/config": "~0.0.41",
        "@types/cors": "~2.8.19",
        "@types/express": "^4.17.25",
        "@types/fs-readfile-promise": "^3.0.4",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "~8.5.9",
        "@types/lodash": "^4.17.27",
        "@types/morgan": "~1.9.10",
        "@types/node": "25.9.1",
        "@types/nodemailer": "~8.0.2",
        "@types/swagger-ui-express": "~4.1.8",
        "copyfiles": "~2.4.1",
        "husky": "~7.0.4",
        "jest": "^29.7.0",
        "lint-staged": "~11.2.6",
        "node-mocks-http": "^1.18.1",
        "nodemon": "^3.1.14",
        "prettier": "~2.6.2",
        "rimraf": "~3.0.2",
        "ts-jest": "^29.4.15",
        "tslint": "^6.1.3",
        "tslint-config-prettier": "~1.18.0",
        "tslint-config-standard": "9.0.0",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@SiLeBAT/fg43-ne-server@1.4.1": {
            "inversify": "~6.0.3",
            "inversify-express-utils": "~6.5.0",
            "express": "4.22.3",
            "@types/express": "^4.17.25",
            "morgan": "~1.12.1",
            "compression": "~1.8.2"
        }
    },
    "fclConfig": {
        "lastChange": "2020-10-20 11:25:17 +0200"
    }
}
